# =====================================================================
# TEMPLATE KONFIGURASI PRODUCTION — KELAR POS
# ---------------------------------------------------------------
# CARA PAKAI:
#   1. Salin file ini -> .env     (JANGAN pernah commit .env asli ke git)
#   2. Isi semua placeholder "[ISI...]" dengan nilai nyata
#   3. Generate APP_KEY:  php artisan key:generate
#   4. JANGAN commit secret (DB password, MIDTRANS_SERVER_KEY) ke repo.
# Referensi lengkap: lihat DEPLOYMENT.md di root proyek.
# =====================================================================

# --- Aplikasi -------------------------------------------------------
APP_NAME="KELAR POS"
APP_ENV=production
APP_KEY=                 # KOSONGKAN. Generate via: php artisan key:generate
APP_DEBUG=false
APP_URL=https://pos-domain-anda.com   # GANTI dengan URL produksi asli (harus https)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------
# "daily" -> rotasi log harian (14 hari), "error" -> hanya error ke atas
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (isi dengan kredensial PRODUKSI) ----------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1        # atau host DB PaaS yang diberikan platform
DB_PORT=3306
DB_DATABASE=[ISI_DB_NAME]
DB_USERNAME=[ISI_DB_USER]
DB_PASSWORD=[ISI_DB_PASSWORD]   # RAHASIA

# --- Session ---------------------------------------------------------
# database = tanpa Redis, aman untuk PaaS. SECURE_COOKIE=true wajib saat HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true     # WAJIB true saat APP_URL https
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache & Queue ---------------------------------------------------
# Aplikasi KELAR memakai event sinkron (tanpa queue worker).
# Queue diset ke database hanya sebagai fallback — worker TIDAK wajib.
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# CATATAN PaaS: filesystem "local" bersifat ephemeral (hilang saat restart)
# bila platform tidak menyediakan volume persist. Simpan upload produk/logo
# di volume atau object storage bila perlu. Local OK untuk MVP.

# --- Reverse Proxy / Load Balancer (PaaS) ----------------------------
# Platform PaaS (Railway/Forge/Heroku) menterminasi HTTPS di proxy.
# "*" = percayai semua proxy (umum untuk PaaS). Isi daftar IP bila
# ingin dibatasi, mis. TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=*

# --- Mail (opsional — aplikasi saat ini TIDAK mengirim email) --------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="kelar@pos-domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Midtrans (Payment Gateway) --------------------------------------
# Kredensial diisi dari dashboard Midtrans Anda.
#   * Sandbox   : dashboard Midtrans -> Settings -> Access Keys (sandbox)
#   * Production: mengganti dengan Live/L1 key.
# PENTING: ganti MIDTRANS_IS_PRODUCTION ke true HANYA setelah key LIVE
# diisi dan sudah ditest (lihat DEPLOYMENT.md). DEFAULT TETAP SANDBOX.
MIDTRANS_SERVER_KEY=[ISI_MIDTRANS_SERVER_KEY]   # RAHASIA — jangan pernah ke frontend
MIDTRANS_CLIENT_KEY=[ISI_MIDTRANS_CLIENT_KEY]   # aman untuk frontend (Snap.js)
MIDTRANS_IS_PRODUCTION=false

# --- Vite / Asset ----------------------------------------------------
VITE_APP_NAME="${APP_NAME}"